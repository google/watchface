<!--
Tests that resources referenced with the Android resource reference syntax ("@drawable/name") are
resolved to the same package resources as bare references ("name"), like the runtime does. This is
the same layout as ImageHiddenInActive.xml, so the expected footprints are identical.
-->
<WatchFace width="450" height="450">
    <Scene>
        <Group alpha="0" name="group1" width="450" height="200" x="0" y="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <PartImage x="0" y="0" width="200" height="200">
                <Image resource="@drawable/ambient-only-image" />
            </PartImage>
        </Group>
        <Group name="group2" width="450" height="200" x="0" y="0">
            <PartImage x="0" y="200" width="200" height="200">
                <Image resource="@drawable/always-rendered-image" />
            </PartImage>
        </Group>
    </Scene>
</WatchFace>
